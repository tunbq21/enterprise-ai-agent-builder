# ===== Enterprise AI Agent Builder - Environment Variables =====

# VITE_GEMINI_API_KEY: Required for "Live LLM" execution mode.
# Get your free API key at: https://aistudio.google.com/app/apikey
# This key is used client-side via the @google/genai SDK.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this app is hosted (used for self-referential links).
APP_URL=http://localhost:3000
